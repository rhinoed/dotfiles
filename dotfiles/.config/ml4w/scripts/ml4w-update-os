#!/usr/bin/env bash

# ============================================================
# Update ML4W OS (FreeBSD Port)
# ============================================================

# Colors for UI
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

info() { echo -e "${GREEN}[INFO]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# Ensure we are in the dotfiles root
REPO_DIR="$HOME/hyprland_config/ml4w/dotfiles"
cd "$REPO_DIR" || error "Could not enter repo directory: $REPO_DIR"

# Ensure we are in the dotfiles root
REPO_DIR="$HOME/hyprland_config/ml4w/dotfiles"
cd "$REPO_DIR" || error "Could not enter repo directory: $REPO_DIR"

# Update from the current remote (origin)
info "Fetching latest updates from origin..."
git fetch origin main || error "Failed to fetch from origin"

info "Merging updates into the current branch..."
if git merge origin/main -m "Update from remote" --no-edit; then
    info "Successfully updated dotfiles from remote!"
else
    error "Merge conflicts occurred. Please resolve them manually in the terminal."
fi

# After updating files, we should trigger a reload of the environment
info "Reloading configuration..."
hl.exec_cmd("~/.config/hypr/scripts/loadconfig.sh") 2>/dev/null || true
hl.exec_cmd("~/.config/ml4w/scripts/ml4w-reload-statusbar") 2>/dev/null || true

info "Update process complete."
