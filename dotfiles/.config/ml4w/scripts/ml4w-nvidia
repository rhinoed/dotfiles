#!/usr/bin/env bash

info() { echo -e "${BLUE}[BOOTSTRAP]${NC} $1"; }
success() { echo -e "${GREEN}[SUCCESS]${NC} $1"; }
warn() { echo -e "${YELLOW}[WARN]${NC} $1"; }
error() { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# --- FreeBSD NVIDIA setup ---

if ! command -v pkg &> /dev/null; then
    echo "ERROR: pkg not found. Unsupported platform for this script."
    exit 1
fi

DISTRO="FreeBSD"
INSTALL_CMD="sudo pkg install -y nvidia-driver nvidia-settings"
CHECK_PKG_CMD="pkg info -e nvidia-driver"

echo
warn "The script will install the NVIDIA graphics drivers on your system."
if gum confirm "Do you want to proceed?"; then
    bash -c "$INSTALL_CMD"

    echo ":: Ensuring nvidia-modeset is loaded at boot..."
    if printf '%s\n' "$(/usr/sbin/sysrc -n kld_list 2>/dev/null)" | grep -qw "nvidia-modeset"; then
        echo ":: nvidia-modeset already in kld_list"
    else
        sudo /usr/sbin/sysrc 'kld_list+=" nvidia-modeset"'
    fi

    echo ":: Activating the NVIDIA environment variant (nvidia.lua)..."
    sed -i '' 's/local name = ".*"/local name = "nvidia.lua"/' $HOME/.config/hypr/conf/environment.lua
    success "Done! Please reboot to apply the NVIDIA driver."
fi