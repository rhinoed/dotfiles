#!/usr/bin/env bash

# FreeBSD: start wpa_supplicant if needed, then open the wifimgr TUI.

if ! command -v wifimgr >/dev/null 2>&1; then
    echo "wifimgr is not installed."
    echo "Install it with: sudo pkg install wifimgr"
    exit 1
fi

if ! pgrep -x wpa_supplicant >/dev/null 2>&1; then
    echo "wpa_supplicant is not running. Attempting to start it..."
    sudo service wpa_supplicant onestart || true
fi

exec wifimgr