#!/usr/bin/env bash

# Check if command exists
_checkCommandExists() {
    command -v "$1" &> /dev/null
}

echo ":: HyprMod is currently not available on FreeBSD."
echo ":: Please check the upstream project for updates: https://github.com/BlueManCZ/hyprmod"
if gum confirm "Install HyprMod from the upstream install script?"; then
    curl -LsSf https://raw.githubusercontent.com/BlueManCZ/hyprmod/main/install.sh | sh
fi