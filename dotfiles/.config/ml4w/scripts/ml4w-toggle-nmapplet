#!/usr/bin/env bash
#                              __    __
#   ___  __ _  ___ ____  ___  / /__ / /_
#  / _ \/  ' \/ _ `/ _ \/ _ \/ / -_) __/
# /_//_/_/_/_/\_,_/ .__/ .__/_/\__/\__/
#                /_/  /_/
#
# FreeBSD: toggles the wifimgr TUI in a floating terminal
# (replaces the nm-applet toggle).
if [[ "$1" == "stop" ]]; then
    pkill -x wifimgr
elif [[ "$1" == "toggle" ]]; then
    if pgrep -x wifimgr >/dev/null; then
        echo "Running"
        pkill -x wifimgr
    else
        echo "Stopped"
        "$(cat ~/.config/ml4w/settings/terminal.sh 2>/dev/null || echo kitty)" --class dotfiles-floating -e wifimgr &
    fi
else
    "$(cat ~/.config/ml4w/settings/terminal.sh 2>/dev/null || echo kitty)" --class dotfiles-floating -e wifimgr &
fi